// 工单桶
const WorkOrderBucket = "work-order"

// Base WorkerOrder 基础方法结构体
type Base struct{}

// WorkerOrderStatusCheck 检查工单任务状态是否允许启动或停止
// taskData: 当前任务详情
// isEnable: 操作类型，1=启动，-1=停止
// 返回 error，如果状态不允许操作，则返回对应错误
func (Base) WorkerOrderStatusCheck(taskData task.TaskDetail, isEnable int) error {
	taskCom := tasklogic.TaskCom{}

	if isEnable == 1 { // 启动操作
		// 如果任务已经是运行状态，则无需改变
		if task.TaskStatus(taskData.TaskStatus) == task.TaskStatusRunning {
			return errors.New("状态没有变化")
		}
		// 检查当前状态是否允许启动
		rs := taskCom.HistoryScanStatusMatch(task.TaskStatus(taskData.TaskStatus), task.TaskStatusRunning)
		if !rs {
			return errors.New("任务状态检测失败,此状态下不能启动")
		}
	}
	// 停止操作
	if isEnable == -1 {
		// 如果任务已经是停止状态，则无需改变
		if task.TaskStatus(taskData.TaskStatus) == task.TaskStatusStop {
			return errors.New("状态没有变化")
		}
		// 检查当前状态是否允许停止
		rs := taskCom.HistoryScanStatusMatch(task.TaskStatus(taskData.TaskStatus), task.TaskStatusStop)
		if !rs {
			return errors.New("任务状态检测失败,此状态下不能停止")
		}
	}

	return nil
}

// WorkerOrderFileUpload 上传工单文件，如果文件存在则覆盖，否则添加
// ctx: 上下文
// tx: 数据库事务
// taskId: 工单任务ID
// w, r: HTTP 请求响应
// 返回 error，如果上传或更新失败则返回
func (Base) WorkerOrderFileUpload(ctx context.Context, tx *gorm.DB, taskId int, w http.ResponseWriter, r *http.Request) error {

	// 确保 MinIO 桶存在，如果不存在则创建
	// 在测试环境中跳过桶检查和创建步骤
	if drivers.MinioClient != nil {
		err := utils.EnsureBucketExistsAndCreat(ctx, drivers.MinioClient, WorkOrderBucket, "", true)
		if err != nil {
			return err
		}
		// 设置桶为公开只读，使上传的文件可外部访问
		err = utils.SetBucketPublicRead(ctx, drivers.MinioClient, WorkOrderBucket)
		if err != nil {
			return err
		}
	}

	// 从表单中获取上传的文件
	file, handler, err := r.FormFile("file")
	if err != nil {
		// 如果没有文件，则直接跳过上传逻辑
		if err == http.ErrMissingFile {
			fmt.Println("用户未上传文件，跳过上传逻辑")
			return nil
		}
		return err
	}
	// 延迟关闭文件，防止资源泄露
	defer file.Close()

	// 生成文件名，格式为 taskId_原始文件名，避免重复
	fileName := fmt.Sprintf("%d_%s", taskId, handler.Filename)

	// 在测试环境中跳过文件上传步骤
	if drivers.MinioClient != nil {
		minioClient := drivers.MinioClient
		// 上传文件到 MinIO
		_, err = minioClient.PutObject(ctx,
			WorkOrderBucket,
			fileName,
			file,
			handler.Size,
			minio.PutObjectOptions{
				ContentType: handler.Header.Get("Content-Type"), // 设置文件 MIME 类型
			})
		if err != nil {
			return err
		}
	}

	// 构建文件访问 URL

	// 在测试环境中使用模拟的URL
	var fileUrl string
	if drivers.MinioClient != nil {
		fileUrl = fmt.Sprintf("http://%s/%s/%s", config.Minio().Endpoint, WorkOrderBucket, fileName)
	} else {
		// 测试环境使用模拟URL
		fileUrl = fmt.Sprintf("http://localhost:9000/%s/%s", WorkOrderBucket, fileName)
	}
	fmt.Println(fileUrl)

	// 更新数据库 task_detail 表的 attachment_url 字段
	taskDetail := task.TaskDetail{}
	updateData := make(map[string]interface{})
	updateData["attachment_url"] = fileUrl
	taskDetail.UpdateById(tx, taskId, updateData)

	return nil
}
